# ============================================================================
#  小爪助手 .gitignore
#
#  设计原则：只排除「生成物」和「私人数据」，源码一律入库。
# ============================================================================

# ---------------------------------------------------------------- Python
__pycache__/
*.py[cod]
*.pyc
*.pyo
*.egg-info/

# ------------------------------------------------------------ 虚拟环境
# 391 MB，绝对不要入库
.venv/
venv/
env/

# ------------------------------------------------------------ 打包产物
# 注意：不要整目录忽略 build/ —— 那里面既有产物也有打包源码。
# build/setup_ui.py 是安装向导的实现，build/*.spec 是打包配置，
# 都是必须入库的源码。所以这里只精确排除生成的中间文件。
build/work/
build/setupwork/
build/payload.zip
build/*.ico
build/*.png

# dist 是完整的可执行发布目录（526 MB），全部是生成物
dist/

# ------------------------------------------------------------ 运行时缓存
# 提示音、截图预览、审计日志都在这里，会自动重建
.cache/

# ------------------------------------------------------- 私人数据与密钥
# .env 里是 API Key；pet_data.json 里是待办和便签。
# 这两个一旦推上去就收不回来了，务必保持忽略。
.env
.env.local
pet_data.json
pet_data.backup.json
*.log

# ---------------------------------------------------------------- 编辑器
.idea/
.vscode/
*.swp
*.swo

# ---------------------------------------------------------------- 系统
.DS_Store
Thumbs.db
desktop.ini
