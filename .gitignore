# ============================================================================
#  小爪助手 .gitignore
#
#  设计原则：只排除「生成物」和「私人数据」，源码一律入库。
# ============================================================================

# ---------------------------------------------------------------- Python
__pycache__/
*.py[cod]
*.pyc
*.pyo
*.egg-info/

# ------------------------------------------------------------ 虚拟环境
# 391 MB，绝对不要入库
.venv/
venv/
env/

# ------------------------------------------------------------ 打包产物
# 注意：不要整目录忽略 build/ —— 那里面既有产物也有打包源码。
# build/setup_ui.py 是安装向导的实现，build/*.spec 是打包配置，
# 都是必须入库的源码。所以这里只精确排除生成的中间文件。
build/work/
build/setupwork/
build/payload.zip
build/*.ico
build/*.png

# dist 是完整的可执行发布目录（526 MB），全部是生成物
dist/

# ------------------------------------------------------------ 运行时缓存
# 提示音、截图预览、审计日志都在这里，会自动重建
.cache/

# 其它 AI 工具在项目目录里留下的本地状态（自己的记忆、会话缓存等）。
# 那是工具的东西，不是项目源码，更不该进公开仓库。
.workbuddy-ai/
.workbuddy/

# ------------------------------------------------------- 私人数据与密钥
# .env 里是 API Key；pet_data.json 里是待办和便签。
# 这两个一旦推上去就收不回来了，务必保持忽略。
.env
.env.local
pet_data.json
pet_data.backup.json
*.log

# 用户自己造的自定义工具（extensions.json）。
#
# **这个仓库是公开的**，而 extensions.json 里装的是使用者本人的工作流：
# 具体的业务话术模板、公司内部系统的排查套路、本机路径
# （比如 C:\Users\PC\Desktop\工单台账.csv）。
# 它属于「私人数据」，和 pet_data.json 一个性质 —— 推上去就收不回来。
#
# 注意：开发模式下这个文件落在项目根目录（store.path.parent），
# 打包后落在 %APPDATA%\PawPet，两边都不会进仓库。
extensions.json
extensions.json.bak*
# 卸载后的回收站：里面同样是用户自己的工具定义，一样的隐私性质
extensions.removed.json

# 对话记录。**里面是用户和 AI 说过的话** —— 工单内容、客户名、
# 文件路径都可能在里面。仓库是公开的，务必保持忽略。
conversations.json
conversations.json.bak*

# 用户改过的界面配色。
#
# 和上面几个一个性质：它是运行时生成在**数据目录**的用户数据
# （开发模式下落在项目根目录，打包后落在 %APPDATA%\PawPet）。
# 不忽略的话，`git add -A` 会把它推上公开仓库 —— 别人克隆下来看到的
# 默认配色会变成某个用户自己的配色，而不是随包的粉白。
theme.json
theme.json.bak*

# ---------------------------------------------------------------- 编辑器
.idea/
.vscode/
*.swp
*.swo

# ---------------------------------------------------------------- 系统
.DS_Store
Thumbs.db
desktop.ini
